# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/tracktok

# Secret key for signing JWT auth tokens - change in production
JWT_SECRET=tracktok_dev_secret_key_change_in_production

# Shared secret for verifying share links between users
SHARE_SECRET=your_share_secret_hex_here
SHARE_JWT_SECRET=your_share_jwt_secret_hex_here

# Public URL of this app (used in emails, redirects, share links)
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Backend API URL for server-side calls to external backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_API_URL=https://your-backend.com/api/

# Long-lived backend token for server-to-server auth with external backend
NEXT_PUBLIC_BACKEND_TOKEN=your_backend_jwt_token

# SMTP credentials for sending emails (GoDaddy or other provider)
BASE_SYSTEM_NODEMAILER_EMAIL_ADDRESS=your@email.com
BASE_SYSTEM_NODEMAILER_EMAIL_PASSWORD=your_email_password

# Google OAuth credentials for social login
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# ─── Reach Cron Service Integration ─────────────────────────────────────────
# URL of the Reach backend that runs cron jobs
REACH_API_URL=http://localhost:3001

# Service API key generated from Reach (POST /api/service-api-keys) - starts with crn_
REACH_API_KEY=crn_your_api_key_here

# Shared secret Reach sends as X-Webhook-Secret when calling /api/cron/execute - must match the webhookSecret registered with the service API key in Reach
CRON_WEBHOOK_SECRET=your_webhook_secret_here
