{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/api/docs"
    }
  ]
}
